{
  "name": "htmlppt-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地运行的 HTML 可视化精修台 —— 加载 AI 生成的 HTML，点选/拖动/缩放/改字/调样式，导出干净 HTML",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "build:single": "BUILD_SINGLEFILE=1 vite build"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "jszip": "^3.10.1",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "happy-dom": "^20.10.2",
    "playwright": "^1.60.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^2.0.0"
  }
}
